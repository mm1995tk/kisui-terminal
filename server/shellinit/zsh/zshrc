# kisui-terminal が書き出した、ユーザーの .zshrc を読むための包み。ユーザーのファイルは書き換えない。
_kisui_zdotdir=$ZDOTDIR
ZDOTDIR=${KISUI_ORIG_ZDOTDIR:-$HOME}
[[ -r $ZDOTDIR/.zshrc ]] && source $ZDOTDIR/.zshrc
# ユーザーのファイルが ZDOTDIR を変えたら、以降はその値のフォルダから読む
[[ $ZDOTDIR != ${KISUI_ORIG_ZDOTDIR:-$HOME} ]] && KISUI_ORIG_ZDOTDIR=$ZDOTDIR
ZDOTDIR=$_kisui_zdotdir
unset _kisui_zdotdir
# pbcopy・pbpaste のフォルダと同梱の shj のフォルダを PATH の先頭に入れ直す
# （ユーザーの起動ファイルや path_helper が前に出した別の pbcopy や shj より先にする）
for _kisui_p in "$KISUI_BIN_PATH_DIR" "$KISUI_SHJ_PATH_DIR"; do
  [[ -n $_kisui_p ]] && path=("$_kisui_p" ${path:#"$_kisui_p"})
done
unset _kisui_p
# ログインシェルは、このあと .zlogin も読む。そこまで ZDOTDIR を kisui のままにする。
if [[ ! -o login ]]; then
  # ZDOTDIR をユーザーの値に戻す
  if [[ -n $KISUI_ORIG_ZDOTDIR ]]; then ZDOTDIR=$KISUI_ORIG_ZDOTDIR; else unset ZDOTDIR; fi
fi
# OSC 133 の印（プロンプトの始まり A・入力の始まり B・コマンドの始まり C・終わり D）を出す。
# 欄の幅が変わるとき、端末はプロンプトの行を組み直さず、シェルの描き直しに任せる（印があるシェルだけ）。
# ユーザーの設定がすでに OSC 133 を出しているときは（最初のプロンプトの前に見つかったら）何もしない。
if [[ -o interactive && -o zle ]]; then
  _kisui_a=$'%{\e]133;A\a%}'
  _kisui_b=$'%{\e]133;B\a%}'
  _kisui_osc133_off() {
    precmd_functions=(${precmd_functions:#_kisui_precmd})
    preexec_functions=(${preexec_functions:#_kisui_preexec})
  }
  _kisui_has_osc133() {
    local f
    for f in precmd preexec $precmd_functions $preexec_functions; do
      [[ $f == _kisui_* ]] && continue
      [[ ${functions[$f]} == *'133;'* ]] && return 0
    done
    [[ $PS1 == *'133;'* ]]
  }
  _kisui_precmd() {
    local ret=$?
    if [[ -z $_kisui_prompted ]]; then
      _kisui_prompted=1
      if _kisui_has_osc133; then _kisui_osc133_off; return $ret; fi
    else
      printf '\e]133;D;%s\a' $ret
    fi
    # A と B は PS1 の中に入れる（幅が変わったとき、シェルは precmd を走らせずにプロンプトだけ描き直すので）
    PS1=${_kisui_a}${${PS1#"$_kisui_a"}%"$_kisui_b"}${_kisui_b}
    return $ret
  }
  _kisui_preexec() { printf '\e]133;C\a'; }
  precmd_functions+=(_kisui_precmd)
  preexec_functions+=(_kisui_preexec)
fi
